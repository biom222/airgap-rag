APP_NAME=AirGapRAG
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://airgap:airgap@postgres:5432/airgap_rag
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_READ_CHUNK_BYTES=1048576
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
AIRGAP_MODE=true
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME_OR_PATH=models/embeddings/multilingual-e5-base
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_TIMEOUT_SECONDS=10
RETRIEVAL_TOP_K=10
RERANKER_ENABLED=false
RERANKER_PROVIDER=mock
RERANKER_MODEL_NAME_OR_PATH=models/rerankers/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_BATCH_SIZE=16
RERANKER_DEVICE=cpu
REDIS_URL=redis://redis:6379/0
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
JOB_RETRY_DELAY_SECONDS=5
JOB_RETRY_MAX_DELAY_SECONDS=60
JOB_STALE_AFTER_SECONDS=960
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=5m
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
RAG_CONTEXT_MAX_CHARACTERS=16000
CHAT_HISTORY_MAX_MESSAGES=10
