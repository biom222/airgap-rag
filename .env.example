APP_NAME=AirGapRAG
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://airgap:airgap@postgres:5432/airgap_rag
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
DOCUMENT_READ_CHUNK_BYTES=1048576
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
AIRGAP_MODE=true
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME_OR_PATH=models/embeddings/multilingual-e5-base
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX="query: "
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_TIMEOUT_SECONDS=10
RETRIEVAL_TOP_K=10
